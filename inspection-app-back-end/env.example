# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (MySQL)
DATABASE_URL="mysql://inspection_user:inspection_password@localhost:3306/inspection_app"

# JWT Configuration
JWT_SECRET=inspection-app-jwt-secret-key-2024
JWT_EXPIRES_IN=7d

# API Configuration
API_VERSION=v1

# FTP/Storage Configuration
FTP_STORAGE_PATH=C:/ftp_data
FTP_PUBLIC_BASE_URL=http://192.168.1.54:4555/uploads
FTP_BASE_URL=ftp://192.168.1.54
FTP_REMOTE_PREFIX=test

# Суурьлуулалтын тайлангийн лого — FTP storage (FTP_STORAGE_PATH) доторх файлын нэр эсвэл relative path. Өгөхгүй бол LOGO_PATH.png
# LOGO_PATH=LOGO_PATH.png

# Үзлэгийн DOCX/PDF-д суулгах зургийн дээд пиксел (урт тал). Олон зурагтай mail/PDF-ийн 500/timeout-г бууруулна. 0 = жижигрүүлэхгүй.
# INSPECTION_DOCX_IMAGE_MAX_EDGE=1280